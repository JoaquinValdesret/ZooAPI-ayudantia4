generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Especie {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(80)
  descripcion String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animales    Animal[]

  @@map("especies")
}

model Recinto {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(100)
  ubicacion String?  @db.VarChar(150)
  capacidad Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animales  Animal[]

  @@map("recintos")
}

model Animal {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(100)
  edad        Int
  peso        Float?
  disponible  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  especieId   Int
  especie     Especie  @relation(fields: [especieId], references: [id], onDelete: Restrict)

  recintoId   Int
  recinto     Recinto  @relation(fields: [recintoId], references: [id], onDelete: Restrict)

  comentarios Comentario[]

  @@map("animales")
}

model Comentario {
  id           Int      @id @default(autoincrement())
  autor        String   @db.VarChar(100)
  calificacion Int
  comentario   String   @db.Text
  createdAt    DateTime @default(now())

  animalId     Int
  animal       Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("comentarios")
}